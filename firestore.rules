rules_version = '2';
// Conta opcional (ver .specs/001-conta-e-sincronizacao.md): cada pessoa só lê e grava os próprios dados, em usuarios/{uid}.
// Cada documento é uma chave do aparelho: { json: texto, em: número, dispositivo: texto }. Publicadas no projeto
// marmota-music-app (Firebase); mudou aqui, publique de novo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/chaves/{chave} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'em', 'dispositivo'])
        && request.resource.data.json is string && request.resource.data.json.size() < 200000
        && request.resource.data.em is number
        && request.resource.data.dispositivo is string && request.resource.data.dispositivo.size() < 64;
    }
  }
}
