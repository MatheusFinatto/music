<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One theme, dark: the Marmota Tuner family (app/res/values/colors.xml). Colors live in Ui.kt (C). -->
    <style name="Theme.MarmotaEar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/azul</item>
        <item name="android:colorControlHighlight">#33EDEDED</item>
    </style>
    <color name="fundo">#FF1E1E1E</color>
    <color name="azul">#FF4AA3FF</color>
</resources>
